# Generated by install.sh at /opt/luma/config/.env. Do not commit the generated file.
LUMA_MODE=domain
LUMA_DOMAIN=api.example.com
LUMA_SITE=api.example.com
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Reserved for future JWT support; current backend uses opaque database-backed tokens.
LUMA_JWT_SECRET=CHANGE_ME
# Must remain identical when restoring or moving an existing database.
LUMA_USERID_HMAC_SECRET=CHANGE_ME
LUMA_STORAGE_DIR=/opt/luma/data/storage
# local (default): local decryption enables unattended rollback.
# offline: encrypt ONLY to the external recipient; never generates a VPS key.
# Keep old private keys off-VPS after separately verifying all old backups.
LUMA_BACKUP_KEY_MODE=local
# Required in offline mode; optional additional recipient in local mode.
# Never put a private identity in this file or in a backup.
# LUMA_BACKUP_RECIPIENT=age1...
# LUMA_BACKUP_IDENTITY is a maintenance-only process variable pointing to a
# temporary tmpfs/ramfs identity file. Do NOT persist it in this .env.
