# Copy to /opt/luma/config/.env; never commit the resulting file.
LUMA_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
# Generate separately with: openssl rand -hex 32 (keep unchanged across updates/restores)
LUMA_USERID_HMAC_SECRET=CHANGE_ME
LUMA_STORAGE_DIR=/opt/luma/data/storage
# APNs is not enabled; no APNs credentials belong in this first deployment.
