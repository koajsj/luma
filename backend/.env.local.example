# Copy to .env.local, then set paths and credentials for your isolated development database.
DATABASE_URL=postgres://luma:luma_dev_only@127.0.0.1:5432/luma?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
LUMA_ADDR=127.0.0.1:8080
LOCAL_STORAGE_DIR=/absolute/path/to/luma/backend/local-data/storage
TLS_CERT_FILE=/absolute/path/to/luma/backend/local-certs/localhost.pem
TLS_KEY_FILE=/absolute/path/to/luma/backend/local-certs/localhost-key.pem
